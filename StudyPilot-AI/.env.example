# Copy to .env (never commit .env). Every value is optional.
# Upload safety limits
STUDYPILOT_MAX_FILE_MB=10
STUDYPILOT_MAX_PAGES=300
STUDYPILOT_MAX_CHARS=1500000

# Chunking (characters)
STUDYPILOT_CHUNK_SIZE=800
STUDYPILOT_CHUNK_OVERLAP=150
STUDYPILOT_TOP_K=4

# Neural embeddings (downloads ~90 MB on first use; falls back to TF-IDF if unavailable)
STUDYPILOT_USE_DENSE_EMBEDDINGS=true
STUDYPILOT_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Optional local language model (needs `pip install transformers torch`; slower on CPU)
STUDYPILOT_USE_GENERATIVE_MODELS=false
STUDYPILOT_GENERATOR_MODEL=google/flan-t5-small

STUDYPILOT_LOG_LEVEL=INFO
